rules_version = '2';

// LifeMon. The game rules live in src/game/engine.js and run inside client
// transactions; these rules are the server-side backstop for the invariants
// that must never break, whatever a client sends.
//
// The QR signing secret ships in the JS bundle, so a determined player can
// always forge a plausible scan. These rules cannot prevent that; they stop
// impossible states (negative stats, more than 8 apples, a degree above PhD)
// from ever being stored.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Teams (sub-groups) 1.1 to 20.2: every group document is a team.
    function validTeamId(id) {
      return id.matches('^([1-9]|1[0-9]|20)[.][12]$');
    }

    function validGroup(d) {
      return d.money is number     && d.money >= 0     && d.money <= 100000000
          && d.food is number      && d.food >= 0      && d.food <= 8
          && d.happiness is number && d.happiness >= 0 && d.happiness <= 1000000
          && d.education is number && d.education >= 0 && d.education <= 4
          && (!('charity' in d) || (d.charity is number && d.charity >= 0));
    }

    // One shared account per team; everyone in the team writes to it.
    // Deletes are allowed so the helper page can reset the game.
    match /groups/{teamId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validTeamId(teamId) && validGroup(request.resource.data);
      allow delete: if signedIn();
    }

    // One record per (QR code, group) - this is what makes each QR usable
    // once per group - plus global-event and manual-adjustment records.
    // Never edited after the fact; doubles as the activity log.
    match /redemptions/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.groupId is string;
      allow update: if false;
      allow delete: if signedIn();
    }

    // Event-wide limits (PhD 2, assassin 1, Final Will 1).
    match /limits/{key} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && request.resource.data.holders is list
                            && request.resource.data.holders.size() <= 40;
      allow delete: if signedIn();
    }

    // A marriage is between at most two groups; its bank pot is never negative.
    match /marriages/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && request.resource.data.participants is list
                            && request.resource.data.participants.size() <= 2
                            && (!('pot' in request.resource.data)
                                || (request.resource.data.pot is number && request.resource.data.pot >= 0));
      allow delete: if signedIn();
    }

    // Shared supermarket donation box.
    match /pools/{key} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && request.resource.data.count is number
                            && request.resource.data.count >= 0
                            && request.resource.data.count <= 1000;
      allow delete: if signedIn();
    }

    // The Final Will vote: open / closed / done (winner announced).
    match /voting/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.status in ['open', 'closed', 'done'];
      allow delete: if signedIn();
    }

    // One vote per team, changeable only while voting is open, for a team
    // of another group: never itself and never its sister team.
    match /votes/{teamId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && validTeamId(teamId)
                            && request.resource.data.voter == teamId
                            && request.resource.data['for'] is string
                            && validTeamId(request.resource.data['for'])
                            && request.resource.data['for'].split('[.]')[0] != teamId.split('[.]')[0]
                            && get(/databases/$(database)/documents/voting/finalWill).data.status == 'open';
      allow delete: if signedIn();
    }

    // Helper-page settings: how many groups appear in the join list.
    match /config/{id} {
      allow read: if signedIn();
      allow delete: if signedIn();
      allow create, update: if signedIn()
                   && request.resource.data.groupCount is int
                   && request.resource.data.groupCount >= 1
                   && request.resource.data.groupCount <= 20;
    }

    // The banner pushed to every phone from the helper page.
    match /announcements/{id} {
      allow read, write: if signedIn();
    }

    // 2024 per-person records, kept as history.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
